{
  "name": "notebookawesome",
  "displayName": "NotebookAwesome",
  "description": "Numbered & nameable cell headers, a color-coded cell navigator, and custom run sequences for Jupyter notebooks. Jump, search, color-tag, and run cells in any order. Works in VS Code, Cursor, Windsurf, and all VS Code-compatible editors.",
  "version": "0.2.2",
  "publisher": "royayon",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/royayon/NoteBookAwesome.git"
  },
  "bugs": {
    "url": "https://github.com/royayon/NoteBookAwesome/issues"
  },
  "homepage": "https://github.com/royayon/NoteBookAwesome#readme",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "jupyter",
    "notebook",
    "ipynb",
    "cells",
    "cell numbers",
    "rename cells",
    "cell headers",
    "navigation",
    "navigator",
    "outline",
    "table of contents",
    "toc",
    "run cells",
    "execute cells",
    "run order",
    "color",
    "data science",
    "cursor",
    "windsurf"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notebookawesome-sidebar",
          "title": "NotebookAwesome",
          "icon": "$(notebook)"
        }
      ],
      "panel": [
        {
          "id": "notebookawesome-panel",
          "title": "NotebookAwesome",
          "icon": "$(notebook)"
        }
      ]
    },
    "views": {
      "notebookawesome-sidebar": [
        {
          "type": "webview",
          "id": "notebookawesome.navigationPanel",
          "name": "Cell Navigator"
        }
      ]
    },
    "commands": [
      {
        "command": "notebookawesome.renameCell",
        "title": "Rename Cell",
        "category": "NotebookAwesome",
        "icon": "$(edit)"
      },
      {
        "command": "notebookawesome.clearCellName",
        "title": "Clear Cell Name",
        "category": "NotebookAwesome",
        "icon": "$(close)"
      },
      {
        "command": "notebookawesome.refreshPanel",
        "title": "Refresh Navigator",
        "category": "NotebookAwesome",
        "icon": "$(refresh)"
      },
      {
        "command": "notebookawesome.navigateToCell",
        "title": "Navigate to Cell",
        "category": "NotebookAwesome"
      },
      {
        "command": "notebookawesome.openNavigator",
        "title": "Open Cell Navigator",
        "category": "NotebookAwesome",
        "icon": "$(notebook)"
      },
      {
        "command": "notebookawesome.jumpToCell",
        "title": "Jump to Cell…",
        "category": "NotebookAwesome",
        "icon": "$(arrow-right)"
      }
    ],
    "configuration": {
      "title": "NotebookAwesome",
      "properties": {
        "notebookawesome.colorPalette": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name of the color"
              },
              "color": {
                "type": "string",
                "description": "CSS color value, e.g. #e05252"
              }
            },
            "required": [
              "name",
              "color"
            ]
          },
          "default": [
            {
              "name": "Red",
              "color": "#e05252"
            },
            {
              "name": "Orange",
              "color": "#e08a3c"
            },
            {
              "name": "Yellow",
              "color": "#d4b83c"
            },
            {
              "name": "Green",
              "color": "#4caf6e"
            },
            {
              "name": "Blue",
              "color": "#4a90d9"
            },
            {
              "name": "Purple",
              "color": "#9b6dd6"
            }
          ],
          "description": "Colors available for cell color tags."
        }
      }
    },
    "keybindings": [
      {
        "command": "notebookawesome.jumpToCell",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "notebookEditorFocused || activeEditor == 'workbench.editor.notebook'"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "notebookawesome.refreshPanel",
          "when": "view == notebookawesome.navigationPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "release": "commit-and-tag-version",
    "release:first": "commit-and-tag-version --first-release"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.70.0",
    "@vscode/vsce": "^2.24.0",
    "commit-and-tag-version": "^12.7.3",
    "esbuild": "^0.20.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.4.0"
  }
}
